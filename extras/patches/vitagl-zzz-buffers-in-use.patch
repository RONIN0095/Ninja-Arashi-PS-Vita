diff --git a/source/buffers.c b/source/buffers.c
index 3c5713c..8b9abc9 100644
--- a/source/buffers.c
+++ b/source/buffers.c
@@ -581,7 +581,25 @@ inline void *glMapNamedBufferRange(GLuint buffer, GLintptr offset, GLsizeiptr le
 	}
 #endif
 
-	// FIXME: Current implementation doesn't take into account 'last_frame' state
+	// Drawn from in this frame: the GPU reads it when the frame is sent, so the
+	// writes would change what those draws show (one far vertex, a huge
+	// triangle). The buffer gets new memory with the old contents instead.
+	if (!gpu_buf->mapped && gpu_buf->ptr && gpu_buf->last_frame == vgl_framecount) {
+		uint8_t *ptr = gpu_buf->alloc_func(gpu_buf->size);
+		if (ptr) {
+			if (access & GL_MAP_INVALIDATE_RANGE_BIT) {
+				if (offset > 0)
+					vgl_memcpy(ptr, gpu_buf->ptr, offset);
+				if (gpu_buf->size - offset - length > 0)
+					vgl_memcpy(ptr + offset + length, (uint8_t *)gpu_buf->ptr + offset + length, gpu_buf->size - offset - length);
+			} else {
+				vgl_memcpy(ptr, gpu_buf->ptr, gpu_buf->size);
+			}
+			mark_as_dirty(gpu_buf->ptr);
+			gpu_buf->ptr = ptr;
+			gpu_buf->last_frame = OBJ_NOT_USED;
+		}
+	}
 	gpu_buf->mapped = GL_TRUE;
 	return (void *)((uint8_t *)gpu_buf->ptr + offset);
 }
@@ -614,7 +632,7 @@ inline GLboolean glUnmapNamedBuffer(GLuint buffer) {
 	}
 #endif
 
-	gpu_buf->last_frame = OBJ_NOT_USED;
+	// last_frame stays: the buffer may have been drawn from this frame
 	gpu_buf->mapped = GL_FALSE;
 	return GL_TRUE;
 }
