+/*
+ * [port patch] Shaders that fail to compile were compiled again (2-4 s each)
+ * on every level load, because only working shaders were cached. Remember
+ * failures in the pack too ("FAIL" records) and go straight to the fallback.
+ */
+static int vgl_cache_failed(const char *fname) {
+	vgl_pack_load();
+	vgl_pack_entry *e = vgl_pack_find(vgl_pack_hash(fname));
+	return e && e->size == 4 && memcmp(vgl_pack_data + e->off, "FAIL", 4) == 0;
+}
+
+static void vgl_cache_mark_failed(const char *fname) {
+	vgl_pack_load();
+	vgl_pack_add(vgl_pack_hash(fname), "FAIL", 4);
+}
+
+// [port patch] Time spent in glLinkProgram (cache reads, compiles, the rest), in us
+uint32_t vgl_link_time_cache = 0, vgl_link_time_compile = 0, vgl_link_time_total = 0;
+uint32_t vgl_link_compiles = 0, vgl_link_failed_cached = 0;
+
 static void vgl_cache_write(const char *fname, const void *buf, size_t sz) {
 	vgl_pack_load();
 	vgl_pack_add(vgl_pack_hash(fname), buf, sz);
