+/*
+ * [port patch] When a GLSL shader can't be translated or compiled, its program
+ * stays NULL and linking would dereference it. Keep its (translated) source
+ * next to the shader cache for debugging and put an invisible stand-in in its
+ * place, so the game keeps running with that one effect missing.
+ */
+static void fallback_shader(shader *s) {
+	static int failures = 0;
+	if (s->prog)
+		return;
+
+	if (s->source && failures < 64) {
+		char path[256];
+		sprintf(path, "%s/failed_%02d_%s.txt", vgl_shader_cache_path, failures, s->type == GL_FRAGMENT_SHADER ? "frag" : "vert");
+		SceUID f = sceIoOpen(path, SCE_O_CREAT | SCE_O_WRONLY | SCE_O_TRUNC, 0777);
+		if (f >= 0) {
+			sceIoWrite(f, s->source, strlen(s->source));
+			sceIoClose(f);
+		}
+	}
+	failures++;
+
+	static const char *dummy_vert = "float4 main() : POSITION { return float4(0.0, 0.0, 2.0, 1.0); }";
+	static const char *dummy_frag = "float4 main() : COLOR { return float4(0.0, 0.0, 0.0, 0.0); }";
+	const char *src = s->type == GL_FRAGMENT_SHADER ? dummy_frag : dummy_vert;
+	if (s->source)
+		vgl_free(s->source);
+	s->size = strlen(src);
+	s->source = (char *)vglMalloc(s->size + 1);
+	vgl_fast_memcpy(s->source, src, s->size + 1);
+#ifdef HAVE_SHADER_CACHE
+	compile_shader(s, GL_FALSE, NULL);
+#else
+	compile_shader(s, GL_FALSE);
+#endif
+}
+
 void glLinkProgram(GLuint progr) {
 	THREAD_SAFE()
 
